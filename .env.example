# Both values below are public client configuration, NOT administrator credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Optional: enable hCaptcha in Supabase Auth, then use the matching PUBLIC site key.
VITE_HCAPTCHA_SITE_KEY=
# Optional native HTTPS hostname YOU control when enabling hCaptcha (no scheme).
# Keep it stable after release. hCaptcha does not accept localhost as a site hostname.
CAPACITOR_HOSTNAME=
# Required for release builds: monitored owner email, shown in Privacy and Safety.
VITE_SUPPORT_EMAIL=
